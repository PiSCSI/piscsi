[Unit]
Description=PiSCSI Web Interface
Documentation=https://github.com/piscsi/piscsi
After=network.target piscsi.service
Wants=piscsi.service

[Service]
Type=simple
User=piscsi-web
Group=piscsi
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/piscsi/web
UMask=0007

# Binary location
ExecStart=/opt/piscsi/web/piscsi-web

# Protected, non-secret configuration. SESSION_KEY_FILE points to the
# separately protected base64 master-key file.
EnvironmentFile=/etc/piscsi-web/piscsi-web.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=piscsi-web
StateDirectoryMode=0700
ReadWritePaths=/var/lib/piscsi/images /var/lib/piscsi/shared /var/lib/piscsi/config

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piscsi-web

[Install]
WantedBy=multi-user.target
